    android:background="@drawable/w_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pv_report" android:textSize="12sp" android:textColor="@color/w_muted" android:textStyle="bold" android:maxLines="1" />
